# LUMI Store Environment Variables

# NextAuth / Auth
NEXTAUTH_SECRET=your-random-32-character-secret
NEXTAUTH_URL=http://localhost:3000

# Google OAuth (Optional in MVP / UI Phase)
GOOGLE_CLIENT_ID=your-google-client-id
GOOGLE_CLIENT_SECRET=your-google-client-secret

# Neon PostgreSQL Database (Phase 2)
DATABASE_URL=postgresql://user:password@ep-sample-pooler.region.neon.tech/lumistore?sslmode=require

# YooKassa Payment Gateway (Phase 2)
YOOKASSA_SHOP_ID=your-shop-id
YOOKASSA_SECRET_KEY=your-secret-key

# Telegram Bot (Phase 3)
TELEGRAM_BOT_TOKEN=your-telegram-bot-token
